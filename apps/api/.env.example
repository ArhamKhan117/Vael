# Copy to .env and fill in. Never commit .env.
PORT=4000

# Chains
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_RPC_FALLBACK_URLS=
SEPOLIA_RPC_URL=
SEPOLIA_RPC_FALLBACK_URLS=
RPC_TIMEOUT_MS=10000
RPC_BATCH_MAX_COUNT=1
WORKER_LOG_CHUNK_MAX=2000
WORKER_LOG_CHUNK_MIN=1
WORKER_ENDPOINT_FAILURE_THRESHOLD=3
WORKER_BATCH_MAX_PROOFS=10
WORKER_BATCH_MAX_SPAN=1000
ATTESTATION_WAIT_TIMEOUT_MS=1200000

# Where worker and indexer state lives: file (default) or supabase.
# Explicit on purpose. A configured SUPABASE_URL never switches the store by itself.
WORKER_STORE=file

# Attestcoin
SOURCE_CHAIN_KEY=1
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Keys (testnet only)
AGENT_CONTROLLER_PRIVATE_KEY=
WORKER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Creditcoin testnet contracts
QUEST_MANAGER_ADDRESS=
REWARD_VAULT_ADDRESS=
BADGE_NFT_ADDRESS=
CAMPAIGN_ESCROW_ADDRESS=
QUEST_ASC_ADDRESS=
VAEL_HERO_ADDRESS=
RAID_BOSS_ADDRESS=
ARENA_ADDRESS=
LOOT_ADDRESS=
EQUIPMENT_ADDRESS=
MARKETPLACE_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=
AGENT_REGISTRY_ADAPTER_ADDRESS=

# Sepolia contracts
QUEST_PORTAL_ADDRESS=

# External services. The Attestcoin worker does not need these; they are validated lazily and
# only when AI generation, IPFS pinning, or the Supabase cache is actually used.
GROQ_API_KEY=
PINATA_JWT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
