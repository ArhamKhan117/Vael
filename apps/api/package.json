{
  "name": "@vael/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "start:worker": "node dist/bin/worker.js",
    "start:indexer": "node dist/bin/indexer.js",
    "lint": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.scripts.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e:portal": "tsx scripts/e2e-portal.ts",
    "worker": "tsx scripts/worker.ts",
    "indexer": "tsx scripts/indexer.ts",
    "reindex": "tsx scripts/reindex.ts",
    "export-state": "tsx scripts/export-state.ts",
    "make-quest": "tsx scripts/make-quest.ts",
    "pin-badges": "tsx scripts/pin-badges.ts",
    "pin-items": "tsx scripts/pin-items.ts",
    "e2e:modules": "tsx scripts/e2e-modules.ts",
    "e2e:arena": "tsx scripts/e2e-arena.ts",
    "e2e:partner": "tsx scripts/e2e-partner.ts",
    "e2e:ai-quest": "tsx scripts/e2e-ai-quest.ts",
    "spike:mainnet": "tsx scripts/spike-mainnet.ts",
    "seed-wallets": "tsx scripts/seed-wallets.ts",
    "seed-content": "tsx scripts/seed-content.ts"
  },
  "keywords": [
    "vael",
    "creditcoin",
    "attestcoin",
    "quests"
  ],
  "author": "Arham Khan",
  "license": "MIT",
  "description": "Vael backend: quest agent, Attestcoin proof worker, and Supabase cache",
  "dependencies": {
    "@gluwa/usc-sdk": "0.18.0",
    "@langchain/core": "^1.0.5",
    "@langchain/groq": "^1.0.1",
    "@supabase/supabase-js": "^2.83.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ethers": "^6",
    "express": "^5.1.0",
    "langchain": "^1.0.5",
    "node-cron": "^4.2.1",
    "viem": "^2.39.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "private": true
}
